{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@web-applications/*": ["../diedericksdobermann-web/src/lib/applications/*"]
    }
  },
  "include": [
    "**/*.ts",
